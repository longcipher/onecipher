[
  {
    "name": "unknown method fails closed",
    "method": "oc_bogus",
    "session": "none",
    "params": {},
    "expected_error_code": 4200
  },
  {
    "name": "missing session_id is invalid params",
    "method": "oc_accounts",
    "session": "none",
    "params": {},
    "expected_error_code": -32602
  },
  {
    "name": "unknown session is unauthorized",
    "method": "oc_accounts",
    "session": "none",
    "params": { "session_id": "deadbeef" },
    "expected_error_code": 4100
  },
  {
    "name": "unlock rejects API tokens",
    "method": "oc_unlock",
    "session": "none",
    "params": { "wallet": "test", "passphrase": "oc_key_0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef" },
    "expected_error_code": 4100
  },
  {
    "name": "unlock rejects unknown wallet",
    "method": "oc_unlock",
    "session": "none",
    "params": { "wallet": "no-such-wallet", "passphrase": "whatever" },
    "expected_error_code": 4100
  },
  {
    "name": "unlock rejects wrong passphrase",
    "method": "oc_unlock",
    "session": "none",
    "params": { "wallet": "test", "passphrase": "definitely-wrong" },
    "expected_error_code": 4100
  },
  {
    "name": "connect_site with unknown session is unauthorized",
    "method": "oc_connect_site",
    "session": "none",
    "params": { "session_id": "deadbeef", "origin": "https://dapp.example", "account_id": "eip155:1" },
    "expected_error_code": 4100
  },
  {
    "name": "connect_site validates account_id",
    "method": "oc_connect_site",
    "session": "valid",
    "params": { "origin": "https://dapp.example", "account_id": "not-a-chain" },
    "expected_error_code": -32602
  },
  {
    "name": "connect_site validates origin",
    "method": "oc_connect_site",
    "session": "valid",
